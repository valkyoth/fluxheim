{
  "schemaVersion": "v6",
  "name": "fluxheim-operations-v1",
  "tags": [],
  "spec": {
    "display": {
      "name": "Fluxheim operations",
      "description": "Fluxheim boundary telemetry; application-internal spans require application instrumentation."
    },
    "duration": "15m",
    "refreshInterval": "5s",
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "name": "service",
          "value": "fluxheim-collector-proof"
        }
      },
      {
        "kind": "TextVariable",
        "spec": {
          "name": "vhost",
          "value": ".*"
        }
      }
    ],
    "links": [],
    "panels": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requests / second",
            "description": "Missing measurements are unavailable, not healthy zero."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "none"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(fluxheim_http_requests_total{\"service.name\"=~\"$service\"}[1m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP 5xx / second",
            "description": "Missing measurements are unavailable, not healthy zero."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "none"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(rate(fluxheim_http_requests_total{\"service.name\"=~\"$service\",status_class=\"5xx\"}[1m]))"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request p95 seconds",
            "description": "Missing measurements are unavailable, not healthy zero."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "s"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "histogram_quantile(0.95, sum by (le) (rate({\"fluxheim_http_request_duration_seconds.bucket\",\"service.name\"=~\"$service\"}[1m])))"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active requests",
            "description": "Missing measurements are unavailable, not healthy zero."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "none"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(fluxheim_http_requests_active{\"service.name\"=~\"$service\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active connections",
            "description": "Missing measurements are unavailable, not healthy zero."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "none"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum(fluxheim_listener_connections_active{\"service.name\"=~\"$service\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Upstream attempts / second",
            "description": "Missing measurements are unavailable, not healthy zero."
          },
          "links": [],
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "formatting": {
                "unit": "none"
              }
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (outcome) (rate(fluxheim_upstream_attempts_total{\"service.name\"=~\"$service\"}[1m]))"
                  }
