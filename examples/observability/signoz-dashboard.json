                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (phase) (rate({\"fluxheim_cache_operation_duration_seconds.count\",\"service.name\"=~\"$service\",vhost=~\"$vhost\"}[1m]))"
