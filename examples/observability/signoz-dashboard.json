            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/PromQLQuery",
                  "spec": {
                    "name": "A",
                    "query": "sum by (reason) (fluxheim_operational_failures_total{\"service.name\"=~\"$service\"})"
                  }
