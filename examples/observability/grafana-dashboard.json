{
  "uid": "fluxheim-operations-v1",
  "title": "Fluxheim operations",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "fluxheim"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / second",
      "interval": "1s",
      "maxDataPoints": 1000,
      "description": "Missing data means unavailable, disabled, or no observations; not healthy zero. Global request metrics have no vhost label.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fluxheim_http_requests_total{job=~\"$job\",instance=~\"$instance\"}[1m]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx / second",
      "interval": "1s",
      "maxDataPoints": 1000,
      "description": "Missing data means unavailable, disabled, or no observations; not healthy zero. Global request metrics have no vhost label.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fluxheim_http_requests_total{job=~\"$job\",instance=~\"$instance\",status_class=\"5xx\"}[1m]))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request p95 seconds",
      "interval": "1s",
      "maxDataPoints": 1000,
      "description": "Missing data means unavailable, disabled, or no observations; not healthy zero. Global request metrics have no vhost label.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fluxheim_http_request_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[1m])))",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Active requests",
      "interval": "1s",
      "maxDataPoints": 1000,
      "description": "Missing data means unavailable, disabled, or no observations; not healthy zero. Global request metrics have no vhost label.",
