ARG RUST_IMAGE=docker.io/library/rust:1.98.1-alpine3.23@sha256:737ba17e6a2ffe14475b59861cd69f3d7152c29c75140bdbf6750befcfda7e6c
ARG RUNTIME_IMAGE=registry.suse.com/bci/php:8@sha256:9d6493f2492630eee0740b639afa4484db0ddef35b3a11cd5f896ccf6871dde6
ARG FLUXHEIM_CONFIG=packaging/container/php-managed.toml

FROM ${RUST_IMAGE} AS builder
WORKDIR /usr/src/fluxheim

RUN apk add --no-cache build-base cmake perl pkgconf \
    && mkdir -p scripts

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY build.rs ./
COPY vendor ./vendor
COPY packaging/systemd ./packaging/systemd
COPY crates ./crates
COPY src ./src
COPY scripts/validate-features.sh scripts/feature-policy.sh ./scripts/

ARG FLUXHEIM_FEATURES=profile-web-server,php-fpm,acme-client
RUN scripts/validate-features.sh "${FLUXHEIM_FEATURES}" \
    && cargo build --locked --release --no-default-features --features "${FLUXHEIM_FEATURES}"

FROM ${RUNTIME_IMAGE}
ARG FLUXHEIM_CONFIG=packaging/container/php-managed.toml
ARG FLUXHEIM_RUNTIME_UID=65532
ARG FLUXHEIM_RUNTIME_GID=65532
ARG FLUXHEIM_RUNTIME_PACKAGES=""

LABEL org.opencontainers.image.title="Fluxheim"
LABEL org.opencontainers.image.description="Fluxheim managed PHP-FPM web server on SUSE BCI"
LABEL org.opencontainers.image.licenses="EUPL-1.2"
LABEL org.opencontainers.image.source="https://github.com/valkyoth/fluxheim"

RUN zypper --non-interactive install ${FLUXHEIM_RUNTIME_PACKAGES} \
    && zypper --non-interactive clean --all \
    && if [ -x /usr/sbin/php-fpm ] && [ ! -e /usr/bin/php-fpm ]; then \
        ln /usr/sbin/php-fpm /usr/bin/php-fpm; \
    fi \
    && mkdir -p /etc/fluxheim /run/fluxheim /var/lib/fluxheim/acme /var/cache/fluxheim /var/log/fluxheim /srv/fluxheim \
    && chown -R ${FLUXHEIM_RUNTIME_UID}:${FLUXHEIM_RUNTIME_GID} /etc/fluxheim /run/fluxheim /var/lib/fluxheim /var/cache/fluxheim /var/log/fluxheim /srv/fluxheim

COPY --from=builder /usr/src/fluxheim/target/release/fluxheim /usr/local/bin/fluxheim
COPY --from=builder /usr/src/fluxheim/target/release/fluxheim-acme /usr/local/bin/fluxheim-acme
COPY ${FLUXHEIM_CONFIG} /etc/fluxheim/fluxheim.toml
COPY packaging/default/index.html /srv/fluxheim/index.html
COPY packaging/default/index.php /srv/fluxheim/index.php

USER ${FLUXHEIM_RUNTIME_UID}:${FLUXHEIM_RUNTIME_GID}
EXPOSE 8080 8443

ENTRYPOINT ["/usr/local/bin/fluxheim"]
CMD ["--config", "/etc/fluxheim/fluxheim.toml"]
