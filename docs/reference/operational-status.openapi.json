{
  "openapi": "3.1.0",
  "info": {
    "title": "Fluxheim Read-Only Operational Status",
    "version": "1.0.0",
    "description": "A bounded projection on the existing authenticated admin listener. Accepts the control-plane token or the separate operational_token_file credential, which authorizes only this GET endpoint. Configured client-certificate policy still applies. Legacy routes are documented in operational-status.md and remain unchanged. No full management API is claimed."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/_fluxheim/operational-status": {
      "get": {
        "operationId": "readOperationalStatus",
        "summary": "Read cached configuration and process-local operational signals",
        "description": "No query parameters or request body. Does not trigger recovery, filesystem access or network probes. HTTP 200 means a sample is available, not that application backends are healthy. Inspect readiness and telemetry separately. Existing client-certificate policy also applies.",
        "responses": {
          "200": {
            "description": "Fixed-size best-effort sample",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "operational-status.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported query",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token missing or incorrect",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Client certificate policy rejected the request",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Only GET is supported",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "414": {
            "description": "Request target exceeds existing admin bounds",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Authentication throttled",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Status busy, stale read unavailable, or collection deadline/size exceeded",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "enum": [
              "unauthorized",
              "admin_auth_throttled",
              "admin_client_certificate_required",
              "admin_client_certificate_denied",
              "method_not_allowed",
              "query_not_supported",
              "operational_status_unavailable",
              "path_too_large",
              "query_too_large"
            ]
          }
        }
      }
    }
  }
}
