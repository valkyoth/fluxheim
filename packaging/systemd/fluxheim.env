# Optional environment for fluxheim.service.
#
# The service defaults to:
#   FLUXHEIM_CONFIG=/etc/fluxheim/fluxheim.toml
#
# Override it only when you intentionally run another config path.
# FLUXHEIM_CONFIG=/etc/fluxheim/fluxheim.toml
#
# RUST_LOG can override the configured logging.level filter if needed.
# RUST_LOG=info
