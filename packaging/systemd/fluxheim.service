[Unit]
Description=Fluxheim reverse proxy and static web server
Documentation=https://github.com/valkyoth/fluxheim
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=fluxheim
Group=fluxheim
Environment=FLUXHEIM_CONFIG=/etc/fluxheim/fluxheim.toml
EnvironmentFile=-/etc/sysconfig/fluxheim
ExecStartPre=/usr/bin/fluxheim --config ${FLUXHEIM_CONFIG} --validate-config
ExecStart=/usr/bin/fluxheim --config ${FLUXHEIM_CONFIG}
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
RuntimeDirectory=fluxheim
RuntimeDirectoryMode=0750
StateDirectory=fluxheim
StateDirectoryMode=0750
CacheDirectory=fluxheim
CacheDirectoryMode=0750
LogsDirectory=fluxheim
LogsDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
ReadWritePaths=/run/fluxheim /var/lib/fluxheim /var/cache/fluxheim /var/log/fluxheim
ReadOnlyPaths=/etc/fluxheim /srv/fluxheim
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
